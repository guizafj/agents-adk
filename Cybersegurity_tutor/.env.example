# Configuración de Ollama
OLLAMA_API_BASE="http://localhost:11434"
OLLAMA_BASE_URL="http://localhost:11434"

# Configuración de Google ADK
ADK_LOG_LEVEL="DEBUG"
ADK_HOST="0.0.0.0"
ADK_PORT="8000"

# ── Contexto y modelo ────────────────────────────────────────────────────────
# Ventana de contexto explícita — qwen3.5 por defecto usa 2048 si no se indica
OLLAMA_NUM_CTX="8192"

# ── Timeouts LiteLLM (segundos) ─────────────────────────────────────────────
# Qwen3.5/3.6 con thinking puede tardar — 300s de margen en respuestas largas
LITELLM_REQUEST_TIMEOUT="300"
LITELLM_CONNECT_TIMEOUT="30"

# ── Persistencia (--session_service_uri en adk run/web) ─────────────────────
PERSISTENCE_DB_PATH="/app/data/persistence/sessions.db"

# ── Compactación de eventos (Fase 3) ────────────────────────────────────────
# Umbral derivado de num_ctx * ratio (default 0.85). Anula el ratio si se define.
# COMPACTION_TOKEN_THRESHOLD="7000"
COMPACTION_THRESHOLD_RATIO="0.85"
COMPACTION_RETENTION_SIZE="4"

# Variables adicionales opcionales
# MOCK_OLLAMA="0"
# DEBUG="0"
